# LLM gateway key (litellm / Odyssey — api.odyssey.scapia.in, corporate network/VPN required)
API_KEY=dontknow

# price-watch backend the cron pulls the worklist from / submits crawl runs to
CRAWL_API_BASE_URL=http://localhost:8000

# cron loop tuning
CRON_POLL_INTERVAL_MS=60000
CRON_ONCE=false          # true -> single pass, then exit
CRON_DRY_RUN=false       # true -> scrape but do not POST crawl runs
CRON_SKIP_REPORT=false   # true -> suppress the per-run summary report
